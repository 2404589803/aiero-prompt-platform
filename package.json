{
  "name": "aiero-prompt-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:server": "pnpm --filter @aiero/server dev",
    "dev:web": "pnpm --filter @aiero/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:legacy": "pnpm --filter @aiero/server import:legacy",
    "migrate": "pnpm --filter @aiero/server migrate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
