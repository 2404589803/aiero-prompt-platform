# 复制成 .env 后填值。.env 已被 gitignore，绝对不要把真实值提交上来。

# ── 后端（Railway）────────────────────────────────────────────────────────────

# 测试库的 Postgres 直连串（Supabase project ref: zoqelpfhurwehlvypryl）
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# 校验前端登录态用，与测试库同一个 Supabase 项目
SUPABASE_URL=https://zoqelpfhurwehlvypryl.supabase.co
SUPABASE_ANON_KEY=

# 目标站点的账号池。JSON 数组，密码里可能带逗号所以不能用逗号分隔。
# 没有配置时平台只能同步角色卡列表，无法抽取提示词。
SCRAPER_ACCOUNTS=[{"email":"","password":""}]

# 允许访问后端的前端来源，逗号分隔。留空表示不限制（仅本地开发用）。
CORS_ORIGINS=https://your-web.vercel.app

# 仅本地开发：设为 true 时后端不校验登录。线上必须留空。
AUTH_DISABLED=

# ── 前端（Vercel，构建时注入）─────────────────────────────────────────────────

VITE_SUPABASE_URL=https://zoqelpfhurwehlvypryl.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://your-server.up.railway.app
