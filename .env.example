# 复制成 .env 后填值。.env 已被 gitignore，绝对不要把真实值提交上来。
# 这个仓库是公开的：所有具体地址、账号、密钥一律只放这里的占位符。

# ── 后端（Railway）────────────────────────────────────────────────────────────

# 测试库的 Postgres 直连串
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# 校验前端登录态用，与测试库同一个 Supabase 项目
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=

# 抓取目标（风月）的站点根地址，结尾不带斜杠。
# 不写死在源码里，换目标站只改这一个值。
SCRAPER_SITE=https://TARGET-SITE

# 风月账号池的「种子」。JSON 数组，密码里可能带逗号所以不能用逗号分隔。
# 账号的实际来源是 aiero.accounts 表，这里只在表为空时导入一次；
# 之后请在平台的「账号池」页面里改，动这个变量不会有任何效果。
SCRAPER_ACCOUNTS=[{"email":"","password":""}]

# 账号密码的加密密钥，随便一串足够长的随机字符即可（生成一次就别再换）。
# 不配也能跑，但密码会明文写进数据库，账号池页面上会挂警告。
# 换掉这个值会让已有密文解不开，需要在页面上重新录一遍密码。
ACCOUNT_SECRET_KEY=

# 允许访问后端的前端来源，逗号分隔。留空表示不限制（仅本地开发用）。
CORS_ORIGINS=https://YOUR-WEB-DOMAIN

# 仅本地开发：设为 true 时后端不校验登录。线上必须留空。
AUTH_DISABLED=

# ── 前端（Vercel，构建时注入）─────────────────────────────────────────────────

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://YOUR-SERVER-DOMAIN
